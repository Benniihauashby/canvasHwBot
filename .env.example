# === TEMPLATE ONLY ===
# Copy this to a local `.env` file (which is gitignored).
# NEVER commit real API keys to GitHub.
#
# cp .env.example .env
# Then fill in your real values below.

# ElevenLabs API key (get from https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID
# Free tier: use a voice you created via Voice Design / Voice Cloning
ELEVENLABS_VOICE_ID=your_voice_id_here

# Future: Canvas API bearer token (when switching from Mockoon to real Canvas)
# Get from Canvas → Account → Approved Integrations → New Access Token
# CANVAS_API_TOKEN=your_canvas_token_here
